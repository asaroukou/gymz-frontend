# IziWellPass web — public client configuration (staging values, no secrets).
# Values come from CloudFormation outputs of stack IziWellPass-staging.

# LOCAL DEV (default): the staging API Gateway does not allow localhost
# origins (and lambda responses carry no CORS headers), so the browser calls
# same-origin /api/backend/* and the Next dev server proxies to the real API
# (see apps/owner/next.config.ts rewrites).
NEXT_PUBLIC_API_BASE_URL=/api/backend
API_PROXY_TARGET=https://ai5q6bb8h2.execute-api.eu-west-1.amazonaws.com/v1

# DEPLOYED (same-domain or CORS-allowed origin): drop API_PROXY_TARGET and
# point NEXT_PUBLIC_API_BASE_URL directly at the gateway:
# NEXT_PUBLIC_API_BASE_URL=https://ai5q6bb8h2.execute-api.eu-west-1.amazonaws.com/v1

NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_Q6H38fENt
NEXT_PUBLIC_COGNITO_CLIENT_ID=11pc9te2bm7lnshn92lbekl004
