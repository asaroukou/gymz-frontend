# IziWellPass web — public client configuration (staging values, no secrets).
# Values come from CloudFormation outputs of stack IziWellPass-staging
# (AWS account 872792314599, eu-west-1), verified live 2026-08-19/22.
# The CloudFormation outputs (ApiUrl / ControlPlaneApiUrl) are truth — these
# change on every stack rebuild.

# LOCAL DEV (default): the staging API Gateway does not allow localhost
# origins (and lambda responses carry no CORS headers), so the browser calls
# same-origin /api/backend/* and the Next dev server proxies to the real API
# (see apps/owner/next.config.ts rewrites).
NEXT_PUBLIC_API_BASE_URL=/api/backend
API_PROXY_TARGET=https://fvj231z5k1.execute-api.eu-west-1.amazonaws.com/v1

# DEPLOYED (same-domain or CORS-allowed origin): drop API_PROXY_TARGET and
# point NEXT_PUBLIC_API_BASE_URL directly at the gateway:
# NEXT_PUBLIC_API_BASE_URL=https://fvj231z5k1.execute-api.eu-west-1.amazonaws.com/v1

NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_wFqcvwlfq
NEXT_PUBLIC_COGNITO_CLIENT_ID=1ig7qvoa48ko3h9jddpitqe90o

# CONTROL PLANE — onboarding, register-owner, admin, billing webhook.
# Same-origin proxy in dev (next.config.ts), same CORS story as the app plane.
NEXT_PUBLIC_CONTROL_PLANE_BASE_URL=/api/control
CONTROL_PLANE_PROXY_TARGET=https://56mp264jf6.execute-api.eu-west-1.amazonaws.com/v1
