        "type": "string",
        "description": "Lifecycle status of a pass holder account.",
        "enum": [
          "active",
          "suspended",
          "churned"
        ]
      },
      "PassPlan": {
        "type": "string",
        "description": "Monthly subscription plan determining credit allocation.\n\nCredits expire at month-end (no rollover). Tier names and credit\ncounts from business doc §7.4 Tier Structure Sensitivity Table.",
        "enum": [
          "starter",
          "active",
          "pro",
          "elite"
        ]
