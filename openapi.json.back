  "components": {
    "schemas": {
      "ApiResponse_AttendanceStats": {
        "type": "object",
        "description": "Standard success response envelope matching the LLD format.\n\nAll successful API responses wrap the payload in a `data` field\nalongside a `request_id` for traceability:\n\n```json\n{\n  \"data\": { ... },\n  \"request_id\": \"req_abc123\"\n}\n```",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Attendance statistics for a venue on a given date.",
            "required": [
              "venue_id",
              "date",
              "total_check_ins",
              "unique_members",
              "occupancy_pct"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "occupancy_pct": {
                "type": "number",
                "format": "double",
                "description": "Occupancy percentage: (check_ins / total_capacity) * 100."
              },
              "total_check_ins": {
                "type": "integer",
                "format": "int64"
              },
              "unique_members": {
                "type": "integer",
                "format": "int64"
              },
              "venue_id": {
                "$ref": "#/components/schemas/VenueId"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ApiResponse_Booking": {
        "type": "object",
        "description": "Standard success response envelope matching the LLD format.\n\nAll successful API responses wrap the payload in a `data` field\nalongside a `request_id` for traceability:\n\n```json\n{\n  \"data\": { ... },\n  \"request_id\": \"req_abc123\"\n}\n```",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "A reservation linking a member or pass holder to a schedule slot.",
            "required": [
              "id",
              "tenant_id",
              "slot_id",
              "source",
              "status",
              "booked_at",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "booked_at": {
                "type": "string",
                "format": "date-time"
              },
              "cancellation_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cancelled_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "checked_in_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "$ref": "#/components/schemas/BookingId"
              },
              "member_id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/MemberId"
                  }
                ]
              },
              "pass_holder_id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/PassHolderId"
                  }
                ]
              },
              "slot_id": {
                "$ref": "#/components/schemas/SlotId"
              },
              "source": {
                "$ref": "#/components/schemas/BookingSource"
              },
              "status": {
                "$ref": "#/components/schemas/BookingStatus"
              },
              "tenant_id": {
                "$ref": "#/components/schemas/TenantId"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ApiResponse_CheckIn": {
        "type": "object",
        "description": "Standard success response envelope matching the LLD format.\n\nAll successful API responses wrap the payload in a `data` field\nalongside a `request_id` for traceability:\n\n```json\n{\n  \"data\": { ... },\n  \"request_id\": \"req_abc123\"\n}\n```",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "A recorded check-in event at a venue.",
            "required": [
              "id",
              "tenant_id",
              "booking_id",
              "member_id",
              "venue_id",
              "method",
              "checked_in_at"
            ],
            "properties": {
              "booking_id": {
                "$ref": "#/components/schemas/BookingId"
              },
              "checked_in_at": {
                "type": "string",
                "format": "date-time"
              },
              "checked_in_by": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Staff user_id for manual check-ins. None for QR self-check-in."
              },
              "id": {
                "$ref": "#/components/schemas/CheckInId"
              },
              "member_id": {
                "$ref": "#/components/schemas/MemberId"
              },
              "method": {
                "$ref": "#/components/schemas/CheckInMethod"
              },
              "tenant_id": {
                "$ref": "#/components/schemas/TenantId"
              },
              "venue_id": {
                "$ref": "#/components/schemas/VenueId"
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ApiResponse_CreditBalance": {
        "type": "object",
        "description": "Standard success response envelope matching the LLD format.\n\nAll successful API responses wrap the payload in a `data` field\nalongside a `request_id` for traceability:\n\n```json\n{\n  \"data\": { ... },\n  \"request_id\": \"req_abc123\"\n}\n```",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Represents a pass holder's current credit state.\n\nCredits expire monthly (no rollover). `debit()` enforces non-negative invariant.",
            "required": [
              "remaining"
            ],
            "properties": {
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "When current credits expire (end of billing month)."
              },
              "remaining": {
                "type": "integer",
                "format": "int32",
                "description": "Credits remaining in current billing cycle."
              }
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ApiResponse_Member": {
        "type": "object",
        "description": "Standard success response envelope matching the LLD format.\n\nAll successful API responses wrap the payload in a `data` field\nalongside a `request_id` for traceability:\n\n```json\n{\n  \"data\": { ... },\n  \"request_id\": \"req_abc123\"\n}\n```",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "A person enrolled at a venue with a membership.",
            "required": [
              "id",
              "tenant_id",
              "first_name",
              "last_name",
              "membership_type",
              "membership_status",
              "membership_start",
              "is_active",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "first_name": {
                "type": "string"
              },
              "id": {
