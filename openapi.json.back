      "PassHolder": {
        "type": "object",
        "description": "An IziWellPass consumer — buys a subscription to access multiple venues.\n\nPlatform-level entity (not tenant-scoped). Maps to `pass_holders` table.",
        "required": [
          "id",
          "user_id",
          "first_name",
          "last_name",
