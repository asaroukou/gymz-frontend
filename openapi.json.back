{
  "openapi": "3.1.0",
  "info": {
    "title": "IziWellPass API",
    "description": "IziWellPass HTTP API. Bearer auth uses the Cognito ID token.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/gms/v1/bookings/{bid}": {
      "get": {
        "tags": [
          "booking"
        ],
        "summary": "Get one booking by id.",
        "operationId": "get_booking",
        "parameters": [
          {
            "name": "bid",
            "in": "path",
            "description": "Booking id (UUID)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_Booking"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid ID token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks booking:read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "cognito_id_token": []
          }
        ]
      }
    },
