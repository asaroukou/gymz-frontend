      "PaginatedApiResponse_Vec_VenueCatalogEntry": {
        "type": "object",
        "description": "Paginated response envelope with cursor metadata.\n\n```json\n{\n  \"data\": [...],\n  \"meta\": { \"next_cursor\": \"abc123\" },\n  \"request_id\": \"req_abc123\"\n}\n```",
        "required": [
          "data",
          "meta",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A venue as seen by marketplace consumers.\n\nMaps to `venue_catalog` table (platform-level, no RLS).\nOnly includes venues where `is_visible = true AND iziwellpass_enabled = true`.",
              "required": [
                "id",
                "tenant_id",
                "name",
                "venue_type",
                "city",
                "country",
                "amenities",
                "rating",
                "total_reviews",
                "credit_cost_per_session",
                "updated_at"
              ],
              "properties": {
                "address_line": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "amenities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "city": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "cover_image_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "credit_cost_per_session": {
                  "type": "integer",
                  "format": "int32"
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "distance_m": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double",
                  "description": "Distance from search point in meters (None if no geo query)."
                },
                "id": {
                  "$ref": "#/components/schemas/VenueId"
                },
                "latitude": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "longitude": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "format": "double"
                },
                "name": {
                  "type": "string"
                },
                "rating": {
                  "type": "number",
                  "format": "double"
                },
                "tenant_id": {
                  "$ref": "#/components/schemas/TenantId"
                },
                "total_reviews": {
                  "type": "integer",
                  "format": "int32"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "venue_type": {
                  "type": "string"
                }
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          },
          "request_id": {
            "type": "string"
          }
        }
