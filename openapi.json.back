          }
        }
      },
      "RecurrenceRule": {
        "type": "string",
        "description": "iCal RRULE string wrapper with basic validation.\n\nSupported MVP patterns:\n- `FREQ=DAILY`\n- `FREQ=WEEKLY;BYDAY=MO,WE,FR`\n- `FREQ=WEEKLY;BYDAY=SA;INTERVAL=2`\n\nFull RRULE parsing (EXDATE, BYMONTHDAY, etc.) deferred to IWP-029."
      },
