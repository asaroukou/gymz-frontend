          "name": {
            "type": "string"
          }
        }
      },
      "VenueSettings": {
        "type": "object",
        "description": "Venue-level settings (stored as JSONB).",
        "properties": {
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "description": "Locale for notifications (e.g., \"fr\", \"en\")"
          },
          "timezone_override": {
            "type": [
              "string",
              "null"
            ],
            "description": "IANA timezone (e.g., \"Africa/Lome\")"
          }
        }
      },
      "VenueType": {
        "type": "string",
        "description": "Type of wellness venue.",
        "enum": [
          "gym",
          "yoga_studio",
          "spa",
          "tennis_club",
          "cross_fit",
          "swimming_pool",
          "martial_arts",
          "dance",
          "other"
        ]
      }
    },
    "securitySchemes": {
      "cognito_id_token": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "AWS Cognito JWT. Send the **ID token** (not the access token): only the ID token carries the `aud` claim and the org_id/role/permissions claims the API authorizer validates."
      }
    }
  },
