# WEB dev only (browser target — CORS applies there; native targets don't need
# this): run `pnpm dev:proxy` (scripts/dev-proxy.mjs, localhost:8082) and point
# the base URL at it instead. Restart `expo start` after changing the value —
# EXPO_PUBLIC_* is inlined at bundle time.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8082

# Offline auth (dev only): any email signs in; the password picks the scenario
# (a role name, or "wrong" / "invite" — see packages/auth/src/mock.ts).
# EXPO_PUBLIC_AUTH_MOCK=1
