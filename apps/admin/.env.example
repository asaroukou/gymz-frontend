# IziWellPass admin app — platform-operator config (staging values, no secrets).
# Values come from CloudFormation outputs of stack IziWellPass-staging
# (AWS account 905609278405, eu-west-1); iziwellpass/docs/client-integration.md
# is truth and these values rotate on every stack rebuild.
#
# This app talks to the CONTROL PLANE only (operator Cognito pool + the admin
# API). It deliberately sets no app-plane vars (no NEXT_PUBLIC_API_BASE_URL /
# API_PROXY_TARGET): apps/admin/app/providers.tsx hardcodes `baseUrl: ''` so
# an accidental app-plane (gms) call fails loudly instead of silently hitting
# the wrong pool/API.

NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_UleNyUcPM
NEXT_PUBLIC_COGNITO_CLIENT_ID=2466and6nmtilcr6qnq6be0gum

# Same-origin proxy in dev (see apps/admin/next.config.ts rewrites).
NEXT_PUBLIC_CONTROL_PLANE_BASE_URL=/api/control
CONTROL_PLANE_PROXY_TARGET=https://o03tlcsz58.execute-api.eu-west-1.amazonaws.com/v1

# DEPLOYED: drop CONTROL_PLANE_PROXY_TARGET and point directly at the gateway:
# NEXT_PUBLIC_CONTROL_PLANE_BASE_URL=https://o03tlcsz58.execute-api.eu-west-1.amazonaws.com/v1
